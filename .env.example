# ---------------------------------------------------------------------------
# ForecastIQ environment configuration. Copy to .env and adjust before running
# `docker compose up`. Never commit the resulting .env file.
# ---------------------------------------------------------------------------

# --- Postgres (used by the postgres service) --------------------------------
POSTGRES_USER=forecastiq
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=forecastiq
POSTGRES_PORT=5432

# --- Application database (async SQLAlchemy URL) ----------------------------
# Docker Compose default. For local dev without Postgres you may use:
#   DATABASE_URL=sqlite+aiosqlite:///./forecastiq.db
DATABASE_URL=postgresql+asyncpg://forecastiq:change-me-postgres@postgres:5432/forecastiq

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
CACHE_TTL_SECONDS=43200

# --- Celery -----------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
# Beat runs the nightly inference batch at 23:00 UTC and the drift check Mondays 06:30 UTC.

# --- Security ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
AUTH_RATE_LIMIT=10/minute

# --- CORS (frontend origins allowed to call the API) ------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- ML artifacts -----------------------------------------------------------
# Directory scanned for forecast_readable.csv, lgbm_model.pkl, metrics.pkl,
# oil_scaler.pkl and tsd_params.pkl. Missing files fall back to synthetic data.
ARTIFACTS_DIR=/artifacts

# --- Forecast thresholds ----------------------------------------------------
ANOMALY_ALERT_THRESHOLD=0.8
ANOMALY_FLAG_THRESHOLD=0.7
COVERAGE_TARGET=0.80
DRIFT_MAPE_THRESHOLD_PP=5.0
DRIFT_CONSECUTIVE_WEEKS=3

# --- SMTP alerting (anomaly + drift emails) ---------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=change-me-smtp
SMTP_FROM=forecastiq-alerts@example.com
SMTP_STARTTLS=true
# Leave false locally so the demo never attempts outbound mail.
ALERTS_ENABLED=false

# --- Demo seed --------------------------------------------------------------
# Password assigned to the four seeded demo users (dev only).
SEED_DEMO_PASSWORD=ForecastIQ!2024

# --- Runtime ---------------------------------------------------------------
ENVIRONMENT=development
API_PREFIX=/api/v1

# --- Ports ------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
